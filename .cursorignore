# Dependencies (largest index cost)
node_modules/

# Next.js build output and cache
.next/
out/
build/
dist/

# Package manager caches
.pnp/
.pnp.js
.yarn/
.pnpm-store/

# Test / coverage artifacts
coverage/

# Vercel / deploy
.vercel/

# Logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db

# Env (secrets; also excluded from git)
.env
.env*.local
