# Database (Neon PostgreSQL)
# Pooled URL (Neon "Connection pooling" host, *-pooler.*) — used by the app at runtime.
# Include sslmode=require, pgbouncer=true, and timeouts so cold-start wake-up does not hit P1001:
# DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15"
DATABASE_URL=""
# Direct URL (Neon primary host, no -pooler) — used by Prisma migrate/db push (schema directUrl)
DIRECT_URL=""

# Auth.js
AUTH_SECRET="generate-a-random-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Production: AUTH_URL and NEXT_PUBLIC_SITE_URL must be the custom domain
# (https://www.rrvastras.in), not *.vercel.app and not www..rrvastras.in.
# Google Cloud Console must also list
# https://www.rrvastras.in/api/auth/callback/google as a redirect URI.

# Admin bootstrap — first Google account with admin access
ADMIN_EMAIL="admin@example.com"

# India Post webhooks (register URLs in DoP portal; use static IP if required)
# INDIAPOST_WEBHOOK_SECRET=""  # HMAC-SHA256 of raw body; required in production
# Booking: https://your-domain/api/webhooks/indiapost/booking
# Events:  https://your-domain/api/webhooks/indiapost/events

# Cashfree
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"
NEXT_PUBLIC_CASHFREE_ENV="sandbox"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
